# Copy to .env.local and fill in values as you reach each phase.
#
# Phase 2 (Auth + Onboarding) requires:
#   MONGODB_URI, AUTH_SECRET
# Optional but recommended:
#   AUTH_URL (or NEXTAUTH_URL) = http://localhost:3000

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- MongoDB (Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splice?retryWrites=true&w=majority

# --- Auth.js / NextAuth v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Legacy aliases (optional if AUTH_SECRET / AUTH_URL are set)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: OAuth / OTP providers (wire in Auth phase)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Pusher (real-time chat; prefer over Socket.io for MVP) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# --- File storage: Cloudflare R2 (preferred) OR AWS S3 ---
# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=splice-uploads
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# S3 (alternative to R2)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=splice-uploads
