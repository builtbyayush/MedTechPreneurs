# Copy to .env.local and fill in values before running the app.
#
# Generate AUTH_SECRET with: openssl rand -base64 32

# --- App ---
NEXT_PUBLIC_APP_NAME=Splice+
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Do NOT set NODE_ENV here — Next.js sets it automatically (development for `npm run dev`, production for `npm run build`).

# LAN / mobile device testing (dev only)
# Comma-separated LAN IPs shown by `npm run dev` under "Network:" — e.g. 192.168.29.16
# Required so Next.js serves /_next/* assets when opening the app from your phone.
DEV_ALLOWED_ORIGINS=192.168.1.39

# --- MongoDB (Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=splice

# --- Auth.js / NextAuth v5 ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Legacy aliases (optional if AUTH_SECRET / AUTH_URL are set)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Admin moderation (Phase 7B) ---
# Comma-separated emails granted role=admin when running `npm run seed`.
# Example: ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=

# --- PWA / Install app ---
# Set NEXT_PUBLIC_APP_URL to your HTTPS production URL before `npm run build`.
# Chrome requires HTTPS + manifest + service worker for "Install app" / Add to Home Screen.
NEXT_PUBLIC_ENABLE_PWA=true

# Optional: OAuth / OTP providers (wire in Auth phase)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Email verification (SMTP) ---
# Hostinger hPanel: Emails → Email Accounts → create e.g. noreply@yourdomain.com
# Use that mailbox password below — NOT your Hostinger account login password.
# Required in production. Without SMTP in dev, codes print in the server terminal.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# Alternative if 465 is blocked: SMTP_PORT=587 and SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# --- Pusher (real-time chat; prefer over Socket.io for MVP) ---
# Required for server publish + private channel auth:
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
# Required for browser client (must match PUSHER_KEY / PUSHER_CLUSTER above):
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
# Debug only — set REALTIME_DEBUG=true for verbose browser/server tracing:
# REALTIME_DEBUG=true
# Re-enable polling fallback after Pusher is verified:
# NEXT_PUBLIC_MESSAGING_POLL_ENABLED=true

# --- Cloudinary (profile photos, future media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- File storage: Cloudflare R2 (preferred) OR AWS S3 ---
# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=splice-uploads
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# S3 (alternative to R2)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=splice-uploads
